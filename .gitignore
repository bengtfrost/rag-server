# ========== RUST / CARGO ==========
target/
**/*.rs.bk
*.rlib
*.rmeta
*.pdb
*.exp
*.lib
*.dylib
*.dll
*.so
*.a
*.o
*.obj
*.exe

# Cargo.lock: commit it — this crate is a binary (`[[bin]]`), not a library.
# It is intentionally NOT ignored.
!Cargo.lock

# sccache / build cache
.sccache/
.cache/

# ========== DEPENDENCIES ==========
/vendor/
.cargo-ok

# ========== EDITORS & IDES ==========
.vscode/
*.code-workspace
*.code-workspace.bak

.zed/
.zed-settings.json

.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Vim
*.swp
*.swo
*.un~
*.orig
*~

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# Sublime Text
*.sublime-workspace
*.sublime-project

# ========== OS GENERATED FILES ==========
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

Thumbs.db
desktop.ini
ehthumbs.db
*.tmp

.directory

# ========== LOGS & DATABASES ==========
*.log
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.db-journal
*.vdb
*.vdb-wal
*.vdb-shm

# ========== ENVIRONMENT & SECRETS ==========
.env
.env.*
!.env.example
# Legacy: a bare file named `env` (no dot) is still a secret, ignore it as a
# file. Trailing-slash form only matches directories — it did not catch the
# `env` file in this repo. `env/` below still covers the Python venv dir.
env
!env.example
.direnv/
.direnvrc
*.pem
*.key
*.crt
*.p12
*.pfx
*.secret
*.secrets
config.toml
!config.toml.example
# MCP client configuration — can contain API tokens / bearer creds.
.mcp.json
.mcp.local.json

# ========== DOCUMENTATION ==========
target/doc/
book/
docs/
*.pdf
*.epub

# ========== TESTS, COVERAGE & PROFILING ==========
*.prof
*.profraw
*.profdata
*.gcno
*.gcda
*.gcov
perf.data
perf.data.*
coverage/
lcov.info
*.lcov
.dhat/

# ========== PYTHON (for mixed projects / tooling) ==========
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
ENV/
env/

# ========== DEBUGGING ARTIFACTS ==========
gdb_history.txt
valgrind.out

# ========== GITHUB SPECIFIC ==========
.github/*.local

# ========== BACKUP FILES ==========
*.bak
*.backup
*.old
*.rej
*.patch
*.diff

# ========== AI / MACHINE LEARNING ==========
# IMPORTANT: tokenizer.json is currently tracked and is required at build
# time (`include_bytes!` / `resources/tokenizer.json`). If you decide to
# build it from Hugging Face at image-build time instead, uncomment the
# line below AND run `git rm --cached tokenizer.json resources/tokenizer.json`.
# tokenizer.json
# resources/tokenizer.json

# Large model weights — never in-repo.
*.gguf
*.onnx

# Platform-specific SQLite extension. Currently NOT tracked. Rebuilt in
# Containerfile from `sqlite-vss` / `sqlite-vec`. To track the prebuilt
# Linux x86_64 object instead, uncomment:
# !resources/extensions/vec0.so

# ========== RELEASE NOTES ==========
.release-notes/
