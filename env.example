#!/usr/bin/env bash
# RAG Server environment template.
# Copy to ~/.config/rag-server/env  (chmod 600), then `source` it per session.
#   $ cp env.example ~/.config/rag-server/env
#   $ chmod 600 ~/.config/rag-server/env
#   $ source ~/.config/rag-server/env

# ---- Embedding model ----
export RAG_EMBED_MODEL="${RAG_EMBED_MODEL:-local-llama-server-embed}"

# ---- Reranker model ----
export RAG_RERANK_MODEL="${RAG_RERANK_MODEL:-local-llama-server-rerank}"

# Derive reranker URL from model selection
case "$RAG_RERANK_MODEL" in
local-llama-server-rerank)
  export RAG_RERANK_URL="http://127.0.0.1:11436/rerank"
  ;;
local-llama-server-rerank-2)
  export RAG_RERANK_URL="http://127.0.0.1:11437/rerank"
  ;;
*)
  export RAG_RERANK_URL="http://127.0.0.1:11436/rerank"
  ;;
esac

# ---- Reranking settings ----
export RAG_RERANK_K="${RAG_RERANK_K:-10}"
export RAG_RERANK_MIN_CANDIDATES="${RAG_RERANK_MIN_CANDIDATES:-3}"
export RAG_RERANK_MIN_SCORE="${RAG_RERANK_MIN_SCORE:-0.3}"

# ---- Concurrency ----
export RAG_MAX_CONCURRENT_FILES="${RAG_MAX_CONCURRENT_FILES:-4}"
export RAG_MAX_CONCURRENT_REQUESTS="${RAG_MAX_CONCURRENT_REQUESTS:-4}"

# ---- Chunking (uncomment to override 1024 / 150) ----
# export RAG_CHUNK_SIZE=1024
# export RAG_CHUNK_OVERLAP=150

# ---- Paths ----
# Defaults resolve from $XDG_DATA_HOME (falls back to ~/.local/share).
# export RAG_DB_PATH="$HOME/.config/rag-server/vectors.db"
# export RAG_RESOURCES_DIR="/path/to/resources"

# ---- Resource paths (advanced) ----
# Directory containing tokenizer.json and extensions/.
# Auto-detected next to the binary or from the crate root; override only
# for custom installs (e.g. a Containerfile that puts resources under
# /usr/local/share/rag-server/resources).
# export RAG_RESOURCES_DIR="$HOME/.config/rag-server/resources"

# Explicit tokenizer override. Defaults to $RAG_RESOURCES_DIR/tokenizer.json,
# then ./tokenizer.json, then ~/.config/rag-server/tokenizer.json.
# export RAG_TOKENIZER_PATH="/path/to/tokenizer.json"

# Explicit vec0.so override. Defaults to $RAG_RESOURCES_DIR/extensions/vec0.so,
# then ./extensions/vec0.so, then ~/.config/rag-server/extensions/vec0.so.
# export RAG_VEC0_EXTENSION_PATH="/path/to/vec0.so"
